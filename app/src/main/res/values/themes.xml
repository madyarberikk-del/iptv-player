<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#E5383B</color>
    <color name="brand_dark">#B71C1C</color>

    <style name="Theme.IptvPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="Theme.IptvPlayer.Player" parent="Theme.IptvPlayer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
